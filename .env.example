# ──────────────────────────────────────────────────────────────────
# Lift — environment placeholders
# Fill in for local dev. In deployed envs, SST injects via Resource bindings.
# ──────────────────────────────────────────────────────────────────

# Mongo (Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lift

# Auth
JWT_SECRET=replace-me-with-a-32-byte-random-string
COOKIE_DOMAIN=localhost

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS End User Messaging SMS (two-way; outbound + inbound)
SMS_POOL_ID=
SMS_INBOUND_SNS_TOPIC_ARN=
SMS_DEFAULT_SENDER_ID=Lift

# Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_DRAFT=anthropic.claude-sonnet-4-6
BEDROCK_MODEL_CLASSIFY=anthropic.claude-haiku-4-5

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_LIFT_79=price_replace_me

# SES
SES_FROM_EMAIL=hello@lift.com
SES_REGION=us-east-1

# S3 (RO photos)
S3_PHOTOS_BUCKET=lift-photos-dev
CLOUDFRONT_PHOTOS_DOMAIN=

# Public URLs (used by API for building public estimate / pay links and CORS)
WEB_APP_URL=http://localhost:5173
MARKETING_URL=http://localhost:5174
API_URL=http://localhost:4000
